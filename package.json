{
  "name": "samikaran-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm run start --workspace=backend",
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n backend,frontend -c \"yellow.bold,cyan.bold\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
